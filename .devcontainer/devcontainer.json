{
  "name": "Gafu Dev Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "postCreateCommand": "rm -f node_modules && bun install",
  "runArgs": [
    "--net=host",
    "--cap-add=SYS_ADMIN"
  ],
  "containerEnv": {
    "CHROME_PATH": "/usr/bin/chromium",
    "BUN_JIT": "0",
    "JSC_useJIT": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
